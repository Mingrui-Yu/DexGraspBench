{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["setting=tabletop", "hand=dummy_arm_shadow", "task=control_eval", "exp_name=learn", 
                     "task.method=ours", "task.offsets=[0.00]", "task.input_data=grasp_dir", 
                     "task.debug_viewer=True", "task.debug_render=False"],
            // "args": ["setting=tabletop", "hand=shadow", "task=eval", "exp_name=learn", 
            //          "task.debug_viewer=True", "task.debug_render=False"],
        }
    ]
}